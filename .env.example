# Optional environment variables for the AI explanation layer.
# Copy to .env and fill in only if you want AI-generated explanations.
# If GOOGLE_AI_KEY is missing the app automatically uses template explanations.

# Google AI Studio (Gemini API)
# Get your free API key from: https://aistudio.google.com/app/apikey
GOOGLE_AI_KEY=your_google_ai_api_key_here
